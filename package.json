{
  "name": "learning-room-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "node --check public/app.js && node --check public/content.js && node --check server/index.mjs && node --check server/domain.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
